# Copy to .env and fill in real values. Never commit .env.

# ── Database (PostgreSQL — hosted on Neon) ──────────────────────────────────
# Runtime: use the POOLED endpoint (host contains "-pooler") so the app goes
# through Neon's PgBouncer connection pooler.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migrations: `prisma migrate deploy` must run against the DIRECT endpoint
# (same host WITHOUT "-pooler"), e.g.:
#   DATABASE_URL='postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require' npx prisma migrate deploy

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Min 32 chars in production
JWT_SECRET=your_long_random_secret_here

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
META_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
# Exactly 64 hex chars (32 bytes) — encrypts per-business WhatsApp tokens at rest
TOKEN_ENCRYPTION_KEY=64_hex_chars_here

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key   # if AI_PROVIDER=openai

# ── Ingest API (optional) ────────────────────────────────────────────────────
# Shared secret for POST /api/ingest/* — used by external automations (e.g.
# Make) to report bot replies when a business runs in external reply mode
# (ai_config.reply_mode = "external"). Leave unset to disable the endpoint.
# INGEST_API_KEY=long_random_secret_here

# ── CORS / frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
