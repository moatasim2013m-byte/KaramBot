// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")  // Uncomment when using connection pooling or proxy services (e.g., PgBouncer, Cloud SQL Auth Proxy)
}

// ─── Business ────────────────────────────────────────────────────────────────

model Business {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  business_type          String   @default("restaurant")
  logo_url               String?
  language_default       String   @default("ar")
  timezone               String   @default("Asia/Amman")
  currency               String   @default("JOD")
  address                String?
  // NULL until WhatsApp is connected: a shop's profile now exists before its number (the join
  // link is sent first). Postgres allows many NULLs under the unique index, and inbound routing
  // refuses a delivery that names no number, so a NULL never matches a webhook.
  wa_phone_number_id     String?  @unique
  wa_business_account_id String?
  wa_access_token        String?  // stored encrypted; never expose raw
  wa_app_id              String?  // Meta app that owns this number's webhooks; selects the signing secret
  // Filled from Meta when the number is connected, so the panels show the shop's real +962
  // number and WhatsApp name instead of a phone_number_id nobody can read.
  wa_display_phone       String?
  wa_verified_name       String?
  meta_business_id       String?  // the shop's Meta portfolio, from GET /me client_business_id
  sector                 String?  // pharmacy | salon | clothing | shop | restaurant | clinic | other
  city                   String?
  owner_phone            String?  // 9627XXXXXXXX: where «راسله» and the owner's alerts go
  source                 String   @default("operator") // operator | invite | self_signup
  // SHIFT's own row and the test (-sim) rows: kept out of fleet totals, the AI ceiling and the
  // attention queue, which they would otherwise inflate.
  is_internal            Boolean  @default(false)
  connected_at           DateTime?
  went_live_at           DateTime? // first AI reply to a non-staff number; can start the free month
  opening_hours          Json     @default("[]")
  status                 String   @default("active")
  ai_config              Json     @default("{}")
  policies               Json     @default("{}")
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  users         User[]
  conversations Conversation[]
  messages      Message[]
  orders        Order[]
  categories    Category[]
  menuItems     MenuItem[]
  modifierGroups ModifierGroup[]
  whatsappOnboarding WhatsappOnboarding?
  subscriptions Subscription[]
  knowledge     BusinessKnowledge[]
  quickReplies      QuickReply[]
  scheduledMessages ScheduledMessage[]
  inboxPresence     StaffInboxPresence[]

  @@index([slug])
  @@index([wa_phone_number_id])
  @@map("businesses")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String    // bcrypt hash
  role        String    @default("staff")
  business_id String?
  active      Boolean   @default(true)
  last_login  DateTime?
  // Tokens minted before this moment are refused. Set when a password changes, so a stolen
  // session cannot outlive the password that created it.
  sessions_valid_from DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  business            Business?      @relation(fields: [business_id], references: [id])
  activations         UserActivation[]
  assignedConversations Conversation[] @relation("AssignedStaff")
  sentMessages        Message[]
  scheduledMessages   ScheduledMessage[] @relation("ScheduledMessageCreator")
  inboxPresence       StaffInboxPresence?
  orderStatusChanges  OrderStatusHistory[]

  @@index([email])
  @@index([business_id])
  @@map("users")
}

// ─── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  id                     String    @id @default(cuid())
  business_id            String
  customer_wa_id         String
  profile_name           String?
  status                 String    @default("open")
  assigned_staff_id      String?
  last_message_at        DateTime  @default(now())
  last_inbound_at        DateTime?
  // Set wherever an outbound row is saved. «Waiting for a reply» is last_inbound_at newer than
  // this; deriving it from last_message_at called every conversation unanswered.
  last_outbound_at       DateTime?
  unread_count           Int       @default(0)
  ai_enabled             Boolean   @default(true)
  current_workflow_type  String?
  current_state          String?
  workflow_data          Json      @default("{}")
  metadata               Json      @default("{}")
  // Inbox v2 (docs/inbox-v2-port-plan.md): what staff organise a conversation by.
  labels                 String[]  @default([])
  snoozed_until          DateTime?
  contact_notes          String?
  custom_label           String?
  needs_attention        Boolean   @default(false)
  attention_reason       String?
  attention_at           DateTime?
  last_staff_read_at     DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  business       Business  @relation(fields: [business_id], references: [id])
  assigned_staff User?     @relation("AssignedStaff", fields: [assigned_staff_id], references: [id])
  messages       Message[]
  orders         Order[]
  scheduledMessages ScheduledMessage[]

  @@unique([business_id, customer_wa_id])
  @@index([business_id])
  @@index([customer_wa_id])
  @@index([business_id, last_message_at])
  @@index([business_id, needs_attention])
  @@index([business_id, snoozed_until])
  @@index([business_id, assigned_staff_id])
  @@index([business_id, last_inbound_at])
  @@map("conversations")
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  id               String   @id @default(cuid())
  business_id      String
  conversation_id  String
  meta_message_id  String?  @unique
  direction        String
  message_type     String   @default("text")
  text_body        String?
  media_id         String?
  media_mime_type  String?
  media_url        String?
  interactive_reply Json?
  location         Json?
  status           String   @default("pending")
  sender_wa_id     String?
  sent_by_user_id  String?
  is_ai_generated  Boolean  @default(false)
  raw_payload      Json?
  // Inbox v2: the quoted message (Meta context.id), reactions, and the delivery timeline.
  reply_to_message_id String?
  reactions        Json?
  delivered_at     DateTime?
  read_at          DateTime?
  failed_at        DateTime?
  error_code       String?
  error_message    String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  business      Business     @relation(fields: [business_id], references: [id])
  conversation  Conversation @relation(fields: [conversation_id], references: [id])
  sent_by_user  User?        @relation(fields: [sent_by_user_id], references: [id])

  @@index([conversation_id])
  @@index([business_id])
  // «ردود الشهر», the cost guard's counts and the newest-200 inspection view all read one
  // business's messages by time.
  @@index([business_id, created_at])
  @@map("messages")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String   @id @default(cuid())
  business_id     String
  conversation_id String
  customer_wa_id  String
  customer_name   String?
  customer_phone  String?
  items           Json     @default("[]")
  subtotal        Float    @default(0)
  delivery_fee    Float    @default(0)
  total           Float    @default(0)
  order_type      String   @default("delivery")
  address         String?
  location        Json?
  notes           String?
  status          String   @default("draft")
  payment_method  String   @default("cash")
  payment_status  String   @default("pending")
  confirmed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  business        Business       @relation(fields: [business_id], references: [id])
  conversation    Conversation   @relation(fields: [conversation_id], references: [id])
  status_history  OrderStatusHistory[]

  @@index([business_id])
  @@index([status])
  @@map("orders")
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  order_id   String
  status     String
  changed_at DateTime @default(now())
  changed_by String?

  order   Order @relation(fields: [order_id], references: [id])
  user    User? @relation(fields: [changed_by], references: [id])

  @@index([order_id])
  @@map("order_status_history")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  business_id String
  name_ar     String
  name_en     String?
  sort_order  Int      @default(0)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business  Business   @relation(fields: [business_id], references: [id])
  menuItems MenuItem[]

  @@index([business_id])
  @@map("categories")
}

// ─── ModifierGroup ────────────────────────────────────────────────────────────

model ModifierGroup {
  id          String   @id @default(cuid())
  business_id String
  name_ar     String
  name_en     String?
  required    Boolean  @default(false)
  min_select  Int      @default(0)
  max_select  Int      @default(1)
  options     Json     @default("[]")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business   Business              @relation(fields: [business_id], references: [id])
  menuItems  MenuItemModifierGroup[]

  @@index([business_id])
  @@map("modifier_groups")
}

// ─── MenuItem ─────────────────────────────────────────────────────────────────

model MenuItem {
  id             String   @id @default(cuid())
  business_id    String
  category_id    String
  name_ar        String
  name_en        String?
  description_ar String?
  description_en String?
  price          Float
  image_url      String?
  active         Boolean  @default(true)
  available      Boolean  @default(true)
  sort_order     Int      @default(0)
  tags           Json     @default("[]")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  business        Business               @relation(fields: [business_id], references: [id])
  category        Category               @relation(fields: [category_id], references: [id])
  modifierGroups  MenuItemModifierGroup[]

  @@index([business_id])
  @@index([category_id])
  @@map("menu_items")
}

model MenuItemModifierGroup {
  menu_item_id      String
  modifier_group_id String

  menuItem      MenuItem      @relation(fields: [menu_item_id], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifier_group_id], references: [id])

  @@id([menu_item_id, modifier_group_id])
  @@map("menu_item_modifier_groups")
}

// ─── Clinic models ────────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(cuid())
  business_id      String
  name_ar          String
  name_en          String?
  duration_minutes Int      @default(30)
  price            Float?
  active           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  doctorServices    DoctorService[]
  appointmentSlots  AppointmentSlot[]
  appointments      Appointment[]

  @@index([business_id])
  @@map("services")
}

model Doctor {
  id          String   @id @default(cuid())
  business_id String
  name_ar     String
  name_en     String?
  specialty_ar String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  doctorServices    DoctorService[]
  appointmentSlots  AppointmentSlot[]
  appointments      Appointment[]

  @@index([business_id])
  @@map("doctors")
}

model DoctorService {
  doctor_id  String
  service_id String

  doctor  Doctor  @relation(fields: [doctor_id], references: [id])
  service Service @relation(fields: [service_id], references: [id])

  @@id([doctor_id, service_id])
  @@map("doctor_services")
}

model AppointmentSlot {
  id          String   @id @default(cuid())
  business_id String
  doctor_id   String?
  service_id  String?
  start_time  DateTime?
  end_time    DateTime?
  is_booked   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  doctor  Doctor?  @relation(fields: [doctor_id], references: [id])
  service Service? @relation(fields: [service_id], references: [id])
  appointments Appointment[]

  @@index([business_id])
  @@map("appointment_slots")
}

model Appointment {
  id              String   @id @default(cuid())
  business_id     String
  conversation_id String?
  customer_wa_id  String?
  customer_name   String?
  customer_phone  String?
  doctor_id       String?
  service_id      String?
  slot_id         String?
  scheduled_at    DateTime?
  status          String   @default("draft")
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  doctor  Doctor?          @relation(fields: [doctor_id], references: [id])
  service Service?         @relation(fields: [service_id], references: [id])
  slot    AppointmentSlot? @relation(fields: [slot_id], references: [id])

  @@index([business_id])
  @@map("appointments")
}

// ─── WhatsappOnboarding ───────────────────────────────────────────────────────
// One row per Embedded Signup (v4) run. Kept beside Business rather than inside it
// because a signup starts before a Business exists and must survive a failed step:
// `step` is the resume point, so a retry continues instead of asking the customer
// to run Embedded Signup again.
model WhatsappOnboarding {
  id                 String    @id @default(cuid())
  business_id        String?   @unique
  app_id             String    // the Meta app that onboarded this WABA; picks the secret for signature checks
  meta_business_id   String
  waba_id            String
  // NULL while the number is unknown: Meta can finish with a WABA and no number (FINISH_ONLY_WABA,
  // or a WABA with several numbers). The row keeps the token and WABA so an operator can complete
  // it (needs_operator) instead of the customer running Embedded Signup again.
  phone_number_id    String?   @unique
  finish_event       String?   // FINISH | FINISH_ONLY_WABA | FINISH_WHATSAPP_BUSINESS_APP_ONBOARDING
  needs_operator     Boolean   @default(false)
  started_by_user_id String?   // who pressed «اربط واتساب»: the owner, or SHIFT staff attending
  access_token_enc   String?   // AES-256-GCM (tokenCrypto). Never logged, never sent to the browser.
  pin_enc            String?   // the 6-digit 2FA PIN, same protection as the token
  step               String    @default("code_received") // → token_exchanged → subscribed → registered → done
  token_exchanged_at DateTime?
  subscribed_at      DateTime?
  registered_at      DateTime?
  // Customer-side, and Meta does not let us read it: primary_funding_id needs the business that
  // owns the app. So staff confirm it, and we record who said so and when — a flag nothing can
  // set is worse than no flag, because the deadline it guards looks permanently unmet.
  payment_method_ok       Boolean   @default(false)
  payment_method_marked_by String?
  payment_method_marked_at DateTime?
  // Two-sided: the owner says «أضفت البطاقة» (claimed), SHIFT confirms (payment_method_ok), and a
  // Meta 131042 refusal on a send overrides both (blocked) until a later delivery clears it.
  payment_method_claimed_at DateTime?
  payment_blocked_at        DateTime?

  // The connection ending on Meta's side (PARTNER_REMOVED, ACCOUNT_DELETED, a token Meta no longer
  // accepts…). Kept apart from last_error: a removed partner is a state, not a failed step.
  revoked_at         DateTime?
  revoked_reason     String?
  // A number change unlinks the old row (business_id NULL) before the new one is linked, which
  // keeps business_id unique and the old row's history.
  detached_at        DateTime?
  token_checked_at   DateTime? // last daily debug_token is_valid check

  // What Meta reports about the number, as of the last check. Stored so the fleet view can show
  // ten accounts without ten Graph calls, always with the timestamp beside it.
  meta_quality_rating String?   // GREEN | YELLOW | RED | UNKNOWN
  meta_throughput     String?   // STANDARD | HIGH …
  meta_number_status  String?   // CONNECTED | FLAGGED | RESTRICTED …
  meta_name_status    String?   // APPROVED | DECLINED | PENDING_REVIEW …
  meta_review_status  String?   // the WABA's account_review_status
  meta_checked_at     DateTime?
  session_id         String?   // Meta's session id, for support escalations
  last_error         String?
  last_error_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  business Business? @relation(fields: [business_id], references: [id])

  @@index([waba_id])
  @@index([step])
  @@map("whatsapp_onboardings")
}

// ─── AdminAccessLog ───────────────────────────────────────────────────────────
// SHIFT staff reading a customer's conversations is a deliberate exception, not a
// routine right: a bot that answers wrongly can only be diagnosed by reading what it
// said. Every such read is recorded here, so the exception stays accountable and the
// alternative — support asking an owner for their password — never becomes tempting.
model AdminAccessLog {
  id              String   @id @default(cuid())
  admin_user_id   String
  admin_email     String
  business_id     String
  conversation_id String?
  action          String   // workspace_list | workspace_thread
  created_at      DateTime @default(now())

  @@index([business_id, created_at])
  @@index([admin_user_id, created_at])
  @@map("admin_access_logs")
}

// ─── UserActivation ───────────────────────────────────────────────────────────
// A one-time link that lets a new customer owner set their own password.
//
// The alternative — SHIFT choosing a password and sending it over WhatsApp — means staff
// knowing a customer's credentials and that password living in a chat thread forever. Only
// the hash of the token is stored, so a database leak does not hand over live invitations.
model UserActivation {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_by String    // the platform_admin who issued it
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_activations")
}

// ─── Subscription ─────────────────────────────────────────────────────────────
// What a customer bought and on what terms. Ten signed contracts need to be visible as ten
// contracts — which solution, since when, for how much, and whether it is paid — not ten
// rows that all say «active». Payments are recorded by hand: Stripe does not serve Jordan,
// and at this size a bank transfer or CliQ reference typed in by staff is the honest record.
model Subscription {
  id            String    @id @default(cuid())
  business_id   String
  solution      String    // karam_bot | automation | website | custom
  plan_name     String?   // free text: «الباقة الأساسية», «Custom — inventory sync»
  status        String    @default("active") // trial | active | past_due | paused | cancelled
  amount_jod    Decimal   @db.Decimal(10, 2)
  billing_cycle String    @default("monthly") // monthly | quarterly | yearly | one_time
  starts_at     DateTime
  ends_at       DateTime?
  next_due_at   DateTime?
  cancelled_at  DateTime?
  // The plan's terms copied onto the contract when it is made (config/plans.js), so changing a
  // default later never silently rewrites a deal already agreed.
  trial_ends_at    DateTime?
  ai_replies_month Int?
  seats            Int?
  campaign         String?   // e.g. irbid-2026-10
  notes         String?
  created_by    String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  business Business  @relation(fields: [business_id], references: [id])
  payments Payment[]

  @@index([business_id, status])
  @@index([next_due_at])
  @@map("subscriptions")
}

// A payment against a subscription, as recorded by staff. `reference` is the transfer or
// CliQ id — the thing you would search a bank statement by.
model Payment {
  id              String   @id @default(cuid())
  subscription_id String
  business_id     String
  amount_jod      Decimal  @db.Decimal(10, 2)
  paid_at         DateTime
  method          String   // bank_transfer | cliq | cash | card | other
  reference       String?
  note            String?
  recorded_by     String
  created_at      DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([business_id, paid_at])
  @@map("payments")
}

// ─── BusinessKnowledge ────────────────────────────────────────────────────────
// What the agent knows about a business that has no sector workflow.
//
// A restaurant's knowledge is its menu and a clinic's is its services, both already modelled.
// Everything else — a pharmacy, a gym, a workshop, a shop — answered production with a fixed
// greeting, so SHIFT could sell to two sectors and serve two. These rows are that missing
// knowledge, entered by the owner and assembled into the agent's prompt the same way a menu is.
//
// `kind` keeps them ordered and labelled for the owner; the model sees them as plain facts.
model BusinessKnowledge {
  id          String   @id @default(cuid())
  business_id String
  kind        String   @default("fact") // fact | faq | service | hours | policy
  question    String?  // for kind = faq
  content     String
  position    Int      @default(0)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, active, position])
  @@map("business_knowledge")
}

// ─── Inbox v2 (docs/inbox-v2-port-plan.md) ──────────────────────────────────────
// Every table carries business_id: the Peekaboo inbox these come from had none, being one business.

model QuickReply {
  id           String    @id @default(cuid())
  business_id  String
  label        String
  text         String
  category     String    @default("other") // greeting | booking | payment | inquiry | closing | other
  is_active    Boolean   @default(true)
  use_count    Int       @default(0)
  last_used_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, is_active])
  @@map("quick_replies")
}

model ScheduledMessage {
  id                 String    @id @default(cuid())
  business_id        String
  conversation_id    String
  text               String?
  template_name      String?
  template_language  String?
  components         Json?
  send_at            DateTime
  status             String    @default("pending") // pending | sent | cancelled | failed
  fail_reason        String?
  sent_message_id    String?
  created_by_user_id String?
  created_at         DateTime  @default(now())
  processed_at       DateTime?

  business     Business     @relation(fields: [business_id], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  created_by   User?        @relation("ScheduledMessageCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([status, send_at])
  @@index([business_id, conversation_id, status])
  @@map("scheduled_messages")
}

model StaffInboxPresence {
  user_id                 String    @id
  business_id             String
  last_seen_at            DateTime
  viewing_conversation_id String?
  typing_conversation_id  String?
  typing_at               DateTime?

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, last_seen_at])
  @@map("staff_inbox_presence")
}

// ─── AccountEvent ─────────────────────────────────────────────────────────────
// One table for what happened to an account and who did it: the activity log, the history of
// every Meta connect attempt, and the questions the bot handed over («ما عرف يجاوب», resolved
// when answered). One table instead of separate signup-attempt, audit and knowledge-gap tables,
// which ten shops do not need. No foreign key, like AdminAccessLog: the record of what happened
// must outlive the row it happened to, and platform events have no business at all.
// Secrets never go into `data` (services/accountEvents.js strips them).
model AccountEvent {
  id            String    @id @default(cuid())
  business_id   String?   // NULL for platform events and an unmatched PARTNER_ADDED
  actor_user_id String?
  actor_kind    String    // owner | staff | shift | system | meta
  type          String
  data          Json      @default("{}")
  resolved_at   DateTime?
  created_at    DateTime  @default(now())

  @@index([business_id, created_at])
  @@index([type, resolved_at])
  @@index([created_at])
  @@map("account_events")
}

// ─── PlatformSetting ──────────────────────────────────────────────────────────
// SHIFT-wide switches and numbers the owner changes without a deploy: whether owners see the
// connect button, the campaign, the AI limits, the CliQ details. The defaults live in code
// (services/platformSettings.js), so an empty table is a working platform and a row only ever
// records a deliberate change.
model PlatformSetting {
  key        String   @id
  value      Json
  updated_by String?
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}
