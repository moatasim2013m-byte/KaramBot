  "loyalty": {
    "source": "bundle.pretty.js ah() L6822-7057, R.loy L4805-4891, ja L6708-6780",
    "illustrativeLabel": {
      "ar": "مثال توضيحي",
      "en": "Illustrative example"
    },
    "eyebrow": {
      "ar": "نقاط الولاء · المنتج 02",
      "en": "Loyalty Points · product 02"
    },
    "title": {
      "ar": "خلّي كل زيارة سببًا لزيارة ثانية.",
      "en": "Give every visit a reason to come back."
    },
    "sub": {
      "ar": "اضبط القواعد كما تريدها، ثم اضغط \"زيارة جديدة\" وشاهد ما يصل عميلك على واتساب.",
      "en": "Set the rules, then tap \"New visit\" to see what the customer receives on WhatsApp."
    },
    "rules": {
      "pointsPerJOD": {
        "id": "l-rate",
        "label": {
          "ar": "نقاط لكل دينار",
          "en": "Points per JD spent"
        },
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 1,
        "unit": {
          "ar": "نقطة",
          "en": "pts"
        },
        "defaultSource": "sectors[sector].pointsPerJOD — sectors.json: 1 for all three",
        "defaultBySector": {
          "clinic": 1,
          "restaurant": 1,
          "store": 1
        }
      },
      "rewardAt": {
        "id": "l-thr",
        "label": {
          "ar": "المكافأة عند",
          "en": "Reward at"
        },
        "min": 50,
        "max": 500,
        "step": 25,
        "default": 100,
        "unit": {
          "ar": "نقطة",
          "en": "pts"
        },
        "defaultSource": "sectors[sector].rewardAt — sectors.json: clinic 200, restaurant 100, store 100",
        "defaultBySector": {
          "clinic": 200,
          "restaurant": 100,
          "store": 100
        }
      },
      "avgTicket": {
        "id": "l-ticket",
        "label": {
          "ar": "متوسط الفاتورة (دينار)",
          "en": "Average bill (JD)"
        },
        "min": 3,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": {
          "ar": "دينار",
          "en": "JD"
        },
        "defaultSource": "sectors[sector].avgTicketJOD — contract: clinic 35, restaurant 12, store 25",
        "defaultBySector": {
          "clinic": 35,
          "restaurant": 12,
          "store": 25
        }
      }
    },
    "formula": {
      "pointsPerVisit": "points = round(avgTicket * pointsPerJOD)",
      "balanceAfterVisit": "balance = balance + points",
      "remaining": "remaining = max(0, rewardAt - balance)",
      "progressPercent": "progress = min(100, round(balance / rewardAt * 100))",
      "unlocked": "unlocked = balance >= rewardAt   // unlock event fires once, when balance crosses rewardAt",
      "redeem": "balance = balance - rewardAt; redeemed = redeemed + 1",
      "lifetime": "lifetime = lifetime + points   // never decreases on redeem",
      "tier": "tier = lifetime >= rewardAt * 5 ? 'gold' : lifetime >= rewardAt * 2 ? 'silver' : 'bronze'",
      "eventsKept": 6
    },
    "tiers": [
      {
        "key": "bronze",
        "label": {
          "ar": "برونزي",
          "en": "Bronze"
        },
        "lifetimeAtLeast": "0"
      },
      {
        "key": "silver",
        "label": {
          "ar": "فضي",
          "en": "Silver"
        },
        "lifetimeAtLeast": "rewardAt * 2"
      },
      {
        "key": "gold",
        "label": {
          "ar": "ذهبي",
          "en": "Gold"
        },
        "lifetimeAtLeast": "rewardAt * 5"
      }
    ],
