  "roi": {
    "source": "bundle.pretty.js ph() L7478-7700, R.roi L5033-5069, N.roi L2300-2334",
    "illustrativeLabel": {
      "ar": "مثال توضيحي",
      "en": "Illustrative example"
    },
    "eyebrow": {
      "ar": "قيمة الأتمتة",
      "en": "Return on automation"
    },
    "title": {
      "ar": "كم توفّر عليك شِفت كل شهر؟",
      "en": "What would SHIFT give back to your month?"
    },
    "inputs": [
      {
        "id": "msgsPerDay",
        "label": {
          "ar": "رسائل العملاء يوميًا",
          "en": "Customer messages per day"
        },
        "min": 10,
        "max": 400,
        "step": 10,
        "default": 60,
        "unit": {
          "ar": "رسالة",
          "en": "msgs"
        }
      },
      {
        "id": "replyMinutes",
        "label": {
          "ar": "دقائق لكل ردّ",
          "en": "Minutes per reply"
        },
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 3,
        "unit": {
          "ar": "دقيقة",
          "en": "min"
        }
      },
      {
        "id": "missedPerWeek",
        "label": {
          "ar": "عملاء ضائعون أسبوعيًا",
          "en": "Missed leads per week"
        },
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 5,
        "unit": {
          "ar": "عميل",
          "en": "leads"
        },
        "warning": "COUNT per week (from the old bundle). sectors.json roiDefaults.missedRate is a FRACTION (0.15/0.2) — not the same quantity; do not map one onto the other without an owner decision"
      },
      {
        "id": "avgTicketJOD",
        "label": {
          "ar": "متوسط الفاتورة (دينار)",
          "en": "Average bill (JD)"
        },
        "min": 3,
        "max": 200,
        "step": 1,
        "default": 12,
        "unit": {
          "ar": "دينار",
          "en": "JD"
        }
      },
      {
        "id": "staffCostPerHour",
        "label": {
          "ar": "تكلفة الموظف بالساعة (دينار)",
          "en": "Staff cost per hour (JD)"
        },
        "min": 2,
        "max": 20,
        "step": 1,
        "default": 4,
        "unit": {
          "ar": "دينار",
          "en": "JD"
        }
      }
    ],
    "defaultsBySector": {
      "clinic": {
        "msgsPerDay": 40,
        "replyMinutes": 3,
        "missedPerWeek": 4,
        "avgTicketJOD": 35,
        "staffCostPerHour": 4
      },
      "restaurant": {
        "msgsPerDay": 80,
        "replyMinutes": 2,
        "missedPerWeek": 5,
        "avgTicketJOD": 12,
        "staffCostPerHour": 4
      },
      "store": {
        "msgsPerDay": 60,
        "replyMinutes": 3,
        "missedPerWeek": 5,
        "avgTicketJOD": 25,
        "staffCostPerHour": 4
      }
    },
    "defaultsSource": "sectors[sector].roiDefaults wins for msgsPerDay, replyMinutes, avgTicketJOD; msgsPerDay/replyMinutes/avgTicketJOD above already mirror sectors.json; missedPerWeek and staffCostPerHour come only from this file (sectors.json missedRate is a fraction, see inputs[].warning)",
    "constants": {
      "daysPerMonth": 30,
      "weeksPerMonth": 4,
      "routineShare": 0.8,
      "recoveredShare": 0.6
    },
    "formula": "hoursSaved = round(msgsPerDay * replyMinutes * 30 / 60 * 0.8);\nleadsRecovered = round(missedPerWeek * 4 * 0.6);\ntimeValue = hoursSaved * staffCostPerHour;\nextraRevenue = leadsRecovered * avgTicketJOD;\ntotal = timeValue + extraRevenue",
    "outputs": [
      {
        "id": "total",
        "primary": true,
        "label": {
          "ar": "القيمة الشهرية الإجمالية",
          "en": "Total monthly value"
        },
        "unit": {
