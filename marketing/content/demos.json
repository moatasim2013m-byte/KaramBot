        "ar": "{{name}} لم يسجّل حضوره. تم تسجيله غائبًا. · {{time}}",
        "en": "{{name}} has not checked in. Marked absent. · {{time}}"
      },
      "timeRule": "late: time = shiftStart + arrivalOffsetMin; absent: time = shiftStart + absentAfterMin; alerts sorted by that offset; alert appears when clock reaches it",
      "sentState": {
        "ar": "أُرسل للمدير · معاينة",
        "en": "Sent to the manager · preview"
      }
