{
  "hosting": [
    {
      "target": "site",
      "public": "site",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "redirects": [
        { "source": "/login",    "destination": "https://app.shifts-ai.com/login",    "type": 302 },
        { "source": "/overview", "destination": "https://app.shifts-ai.com/overview", "type": 302 },
        { "source": "/inbox",    "destination": "https://app.shifts-ai.com/inbox",    "type": 302 },
        { "source": "/orders",   "destination": "https://app.shifts-ai.com/orders",   "type": 302 },
        { "source": "/menu",     "destination": "https://app.shifts-ai.com/menu",     "type": 302 },
        { "source": "/clinic",   "destination": "https://app.shifts-ai.com/clinic",   "type": 302 },
        { "source": "/reports",  "destination": "https://app.shifts-ai.com/reports",  "type": 302 },
        { "source": "/staff",    "destination": "https://app.shifts-ai.com/staff",    "type": 302 },
        { "source": "/settings", "destination": "https://app.shifts-ai.com/settings", "type": 302 }
      ],
      "headers": [
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]},
        { "regex": "^/([^.]*)$", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
        { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
      ]
    },
    {
      "target": "app",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [
        { "source": "**", "run": { "serviceId": "karambot", "region": "europe-west1" } }
      ]
    }
  ]
}
